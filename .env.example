# Copie para .env e ajuste o IP LAN do seu PC (veja com ipconfig).
# Aparelho fisico NAO alcanca 10.0.2.2 — use o IP da maquina na Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3001

# Token PUBLICO do Mapbox (pk....). Usado no Static Images API + geocoding.
# Pegue em https://account.mapbox.com/access-tokens/ (mesmo token publico do web).
EXPO_PUBLIC_MAPBOX_TOKEN=
